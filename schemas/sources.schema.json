{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:materials-boundaries:schema:sources:1.0.0",
  "title": "Materials Boundaries sources v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "read_status": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "identifier": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "identifier"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claim_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "curation_date": {
                "type": "string",
                "format": "date"
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "curation_date",
              "method"
            ]
          },
          "bundled_content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "authors",
          "year",
          "doi",
          "urls",
          "read_status",
          "license",
          "role",
          "claim_notes",
          "provenance",
          "bundled_content"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ]
}
