{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Materials Boundaries small task envelope",
  "description": "Proposed operator envelope only. It is not supported by repository CLIs and does not replace source, scientific, rights, authority or independent review. Validate offline; no remote references are needed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
