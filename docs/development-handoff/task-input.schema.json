            "grades": {
              "type": "integer",
              "minimum": 0
            },
            "states": {
              "type": "integer",
              "minimum": 0
            },
            "properties": {
              "type": "integer",
              "minimum": 0
            },
            "sources": {
              "type": "integer",
              "minimum": 0
